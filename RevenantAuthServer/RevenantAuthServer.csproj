    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Контейнер Render free = 512 МБ: Server GC резервирует слишком много памяти
             и приводит к молчаливому OOM-убийству. Используем Workstation GC. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <AssemblyName>RevenantAuthServer</AssemblyName>
        <Product>Revenant Auth Server</Product>
        <Version>1.0.0</Version>
        <Company>lotesnowhallen</Company>
        <Copyright>© 2026 lotesnowhallen</Copyright>
    </PropertyGroup>
